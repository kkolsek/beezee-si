# BEGIN Pausie domain redirects (pausie.si, getpausie.com -> pausie.app)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?pausie\.si$ [NC,OR]
RewriteCond %{HTTP_HOST} ^(www\.)?getpausie\.com$ [NC]
RewriteRule ^(.*)$ https://pausie.app/$1 [R=301,L]
</IfModule>
# END Pausie domain redirects

# BEGIN Lonc domain redirect (lonc.si -> lonc.app)
RewriteCond %{HTTP_HOST} ^lonc\.si$ [OR]
RewriteCond %{HTTP_HOST} ^www\.lonc\.si$
RewriteRule ^/?$ "https\:\/\/lonc\.app\/" [R=301,L]
# END Lonc domain redirect

# beezee.si – statična stran
# Preusmeritve pausie/lonc zgoraj so del te datoteke – ne briši jih (domene so parkirane na beezee.si).

DirectoryIndex index.html index.php
Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On

# https + brez www
RewriteCond %{HTTP_HOST} ^(www\.)?beezee\.si$ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://beezee.si/$1 [R=301,L]

# stare WordPress poti (blog, kategorije …) → domača stran
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^(wp-|blog|category|tag|author|feed|page/|\d{4}/) / [R=301,L]
</IfModule>

# config.php ni dostopen prek spleta
<Files "config.php">
  Require all denied
</Files>
<Files "config.example.php">
  Require all denied
</Files>

# predpomnjenje statičnih datotek
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(woff2|webp|png|ico)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

ErrorDocument 404 /index.html
